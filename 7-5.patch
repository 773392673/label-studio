+    def test_empty_filepath_returns_403(self, api_factory, user, view):
+        """Test that empty string filepath (?filepath=) returns 403"""
+        request = api_factory.get('/storage-data/uploaded/', {'filepath': ''})
+        request.user = user
+
+        response = view.get(request)
+        assert response.status_code == status.HTTP_403_FORBIDDEN
+
+    @mock.patch('data_import.api.User.objects.filter')
+    def test_avatar_same_org_access_grants_file(self, mock_filter, api_factory, user, view):
+        """Test that avatar file is accessible when both users belong to the same organization"""
+        mock_avatar_user = Mock()
+        mock_avatar_file = Mock()
+        mock_avatar_file.open = Mock(return_value=Mock())
+        mock_avatar_user.avatar = mock_avatar_file
+        mock_filter.return_value.first.return_value = mock_avatar_user
+
+        user.active_organization.has_user = Mock(return_value=True)
+
+        request = api_factory.get('/storage-data/uploaded/', {'filepath': f'{settings.AVATAR_PATH}/avatar.jpg'})
+        request.user = user
+
+        with mock.patch('data_import.api.settings.USE_NGINX_FOR_UPLOADS', False), \
+             mock.patch('data_import.api.RangedFileResponse') as mock_ranged:
+            mock_response_instance = Mock()
+            mock_response_instance.__setitem__ = Mock()
+            mock_ranged.return_value = mock_response_instance
+
+            response = view.get(request)
+
+            user.active_organization.has_user.assert_called_once_with(mock_avatar_user)
+            assert response == mock_response_instance
+            mock_ranged.assert_called_once()
+
+    @mock.patch('data_import.api.FileUpload.objects.filter')
